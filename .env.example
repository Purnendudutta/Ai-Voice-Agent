# ==============================================================================
# AI Voice Desktop Assistant - Environment Configuration
# ==============================================================================

# Gemini API Key (Obtain from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here


# Live Model Selection (Recommended: gemini-3.1-flash-live-preview)
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Audio Configuration
AUDIO_INPUT_SAMPLE_RATE=16000
AUDIO_OUTPUT_SAMPLE_RATE=24000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=1024
VAD_ENERGY_THRESHOLD=0.015
VAD_SILENCE_DURATION=0.8

# Wake Word Settings
WAKE_WORD_ENABLED=true
WAKE_WORDS=["jarvis", "gemini", "computer", "assistant"]
WAKE_WORD_SENSITIVITY=0.65

# Security & IPC
IPC_SECRET_KEY=change_this_to_a_random_secure_hex_token
IPC_PORT=8765
WEB_UI_PORT=8000
ALLOW_CRITICAL_OPERATIONS_WITH_CONFIRMATION=true
MAX_EXECUTION_RETRIES=3
TOOL_TIMEOUT_SECONDS=15

# Agent & Memory
STORAGE_DIR=./data
AUDIT_LOG_FILE=./data/audit.jsonl
MEMORY_DB_FILE=./data/agent_memory.db
DEGRADED_MODE_ENABLED=true
VOICE_NAME=Puck

# Full Computer & Cursor Access
FULL_COMPUTER_ACCESS=true
REQUIRE_CONFIRMATION_FOR_HIGH_RISK=false
